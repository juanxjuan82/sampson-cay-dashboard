{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sampson-cay-dashboard-ai",
  "main": "src/index.js",
  "compatibility_date": "2026-08-10",
  "vars": {
    "OPENAI_MODEL": "gpt-5.6-terra",
    "ALLOWED_ORIGINS": "https://juanxjuan82.github.io,http://localhost:8000,http://127.0.0.1:8000"
  },
  "triggers": {
    "crons": [
      "0 */6 * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sampson-cay-monitor",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}
